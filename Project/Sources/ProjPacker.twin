' https://github.com/GCuser99/tbImportExport/tree/main
' License: MIT
'
' ProjPacker -- public entry points for the twinproj/twinpack unpack/pack
' package.
'
' Three functions, each returning True on success and False on failure:
'
'   Pack(inputDir, outputFile, [overwrite], [logFile])
'   Unpack(inputFile, outputDir, [cleanFirst], [logFile])
'   Test(samplePath, [logFile])
'
' Error model: these never raise. Any failure in the core is caught here and
' reported as a False return, with the reason emitted through Say (so it
' appears in the IDE immediate window via Debug.Print, and in the log file
' when one is supplied). A caller that wants detail reads the log; a caller
' that just needs a yes/no checks the return value.
'
' The one exception is a failure to open the requested log file itself:
' since the caller explicitly asked for a log, that is surfaced as a False
' return with the reason on Debug.Print, the same as any other failure --
' the operation does not proceed logless and pretend success.
'
' Output: every operation always calls Debug.Print for its progress and
' summary lines (free, and skipped when compiled). Supplying logFile
' additionally writes those same lines to a UTF-8 file, overwriting it.

Public Class ProjPacker

    Option Explicit

    ' Pack a directory tree into a .twinproj / .twinpack file.
    ' overwrite:=True replaces an existing output file; without it, an
    ' existing output causes a False return (the .twinproj is a source of
    ' truth and is not clobbered silently).
    Public Function Pack(ByVal inputDir As String, _
                         ByVal outputFile As String, _
                         Optional ByVal overwrite As Boolean = False, _
                         Optional ByVal logFile As String = "") As Boolean
        Return RunGuarded("Pack", logFile, _
                          inputDir, outputFile, overwrite, False, opPack)
    End Function

    ' Unpack a .twinproj / .twinpack file into a directory tree.
    ' cleanFirst:=True empties the target directory first (refusing a
    ' dangerously shallow target). Overwriting an unpacked tree is the safe
    ' direction, so no overwrite opt-in is required.
    Public Function Unpack(ByVal inputFile As String, _
                           ByVal outputDir As String, _
                           Optional ByVal cleanFirst As Boolean = False, _
                           Optional ByVal logFile As String = "") As Boolean
        Return RunGuarded("Unpack", logFile, _
                          inputFile, outputDir, False, cleanFirst, opUnpack)
    End Function

    ' Run the self-test suite. Requires a sample .twinproj / .twinpack path.
    ' Returns True only if every test passed.
    Public Function Test(ByVal samplePath As String, _
                         Optional ByVal logFile As String = "") As Boolean
        Return RunGuarded("Test", logFile, _
                          samplePath, "", False, False, opTest)
    End Function

    ' ---------------------------------------------------------------- private

    Private Enum OpKind
        opPack = 1
        opUnpack = 2
        opTest = 3
    End Enum

    ' Shared wrapper: opens the log (if requested), dispatches to the core,
    ' converts a raised error into a False return with the reason emitted,
    ' and always closes the log. Keeping the log lifecycle and the catch in
    ' one place means the three public functions cannot forget either.
    Private Function RunGuarded(ByVal opName As String, _
                                ByVal logFile As String, _
                                ByVal arg1 As String, _
                                ByVal arg2 As String, _
                                ByVal overwrite As Boolean, _
                                ByVal cleanFirst As Boolean, _
                                ByVal kind As OpKind) As Boolean
        On Error GoTo Failed

        If Len(logFile) > 0 Then LogOpen logFile   ' raises if it cannot open

        Dim ok As Boolean
        ok = True

        Select Case kind
            Case opPack
                DoExport AbsPath(arg1), AbsPath(arg2), False, _
                         requireSettings:=True, overwrite:=overwrite
            Case opUnpack
                DoImport AbsPath(arg1), AbsPath(arg2), False, _
                         cleanFirst:=cleanFirst
            Case opTest
                ' RunSelfTest returns 0 on all-pass, nonzero otherwise.
                If RunSelfTest(AbsPath(arg1)) <> 0 Then ok = False
        End Select

        LogClose
        Return ok

Failed:
        ' Emit the reason (Debug.Print always; log too if it opened before
        ' the failure), then report failure. LogClose is safe even if the
        ' failure was LogOpen itself -- it no-ops when nothing is open.
        Say opName & " failed: " & Err.Description
        LogClose
        Return False
    End Function

End Class
