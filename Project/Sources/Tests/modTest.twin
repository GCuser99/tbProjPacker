Private Module modTest
    Private Sub UnpackTwinProj()
        Dim inProjFilePath As String
        Dim outProjFolderPath As String
        
        inProjFilePath = App.Path & "\tbProjPacker.twinproj"
        outProjFolderPath = App.Path & "\Project"
        
        ' Run Unpack with cleanFirst
        Dim pp As New ProjPacker
        Debug.Assert pp.Unpack(inputFile:=inProjFilePath, outputDir:=outProjFolderPath, cleanFirst:=True)
        
        ' Run Unpack with cleanFirst and logging
        Debug.Assert pp.Unpack(inputFile:=inProjFilePath, outputDir:=outProjFolderPath, logfile:=".\log.txt", cleanFirst:=True)
        
        ' Run Test with logging
        Debug.Assert pp.Test(samplePath:=inProjFilePath, logFile:=".\log.txt")
        
        Dim lineText As String
        Dim fileNum As Integer

        fileNum = FreeFile

        Open ".\log.txt" For Input As #fileNum
        Do Until EOF(fileNum)
            Line Input #fileNum, lineText
        Loop
        Close #fileNum
        
        Debug.Assert lineText = "17/17 tests passed."
    End Sub
    
    Private Sub PackTwinProj()
        Dim inProjFolderPath As String
        Dim outProjFilePath As String
        
        outProjFilePath = App.Path & "\test_pack.twinproj"
        inProjFolderPath = App.Path & "\Project"
        
        Dim pp As New ProjPacker
        'Run Pack with overwrite and logging
        Debug.Assert pp.Pack(inputDir:=inProjFolderPath, outputFile:=outProjFilePath, logfile:=".\log.txt", overwrite:=True)
        
        'Run Pack without overwrite and with logging - should return False (fail) because .twinproj already exists and overwrite:=False
        Debug.Assert Not pp.Pack(inputDir:=inProjFolderPath, outputFile:=outProjFilePath, logfile:=".\log.txt")
        
        Dim lineText As String
        Dim fileNum As Integer

        fileNum = FreeFile

        Open ".\log.txt" For Input As #fileNum
        Do Until EOF(fileNum)
            Line Input #fileNum, lineText
        Loop
        Close #fileNum
        
        Debug.Assert Left$(lineText, 11) = "Pack failed"
    End Sub
        
End Module