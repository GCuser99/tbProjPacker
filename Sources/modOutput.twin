' https://github.com/GCuser99/tbImportExport/tree/main
' License: MIT
'
' modOutput -- the package's output sink.
'
' The core (modImpExp) and the test suite (modSelfTest) both emit their
' progress and summary lines by calling Say. In the CLI build, Say wrote to
' the console. In the package build, Say instead:
'
'   * always calls Debug.Print -- free, visible in the IDE immediate window,
'     silently skipped when compiled, so it costs nothing in any build;
'   * additionally writes the line to a log file, when one has been opened
'     for the current operation via LogOpen.
'
' Because the core and test files call Say unqualified, this module simply
' provides a different Say than the CLI did -- neither the core nor the
' tests change between the two builds.
'
' Encoding: the log is UTF-8 with Windows (CRLF) line endings, no BOM.
' Project output routinely contains non-ASCII file names, so the line is
' encoded through Utf8Encode and written as bytes via WriteFile -- the same
' mechanism the tool uses everywhere else it must be codepage-correct.

Private Module modOutput

    Option Explicit

    Private mLogOpen As Boolean
    Private mLogHandle As LongPtr

    ' Opens a log file for the current operation with overwrite semantics
    ' (CREATE_ALWAYS truncates any existing file). Raises IE_ERR_IO on
    ' failure: the caller asked for a log, so failing to produce one is an
    ' error, not something to paper over. ApiPath handles long paths.
    Public Sub LogOpen(ByVal path As String)
        LogClose                              ' defensive: never leak a prior handle

        Dim full As String
        full = AbsPath(path)

        Dim sa As SECURITY_ATTRIBUTES         ' zero-filled: default security
        Dim h As LongPtr
        h = CreateFileW(StrPtr(ApiPath(full)), GENERIC_WRITE, 0, sa, _
                        CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
        If h = INVALID_HANDLE_VALUE Then
            Err.Raise IE_ERR_IO, "LogOpen", _
                "Cannot open log file for writing: """ & full & """"
        End If

        mLogHandle = h
        mLogOpen = True
    End Sub

    Public Sub LogClose()
        If mLogOpen Then
            CloseHandle mLogHandle
            mLogOpen = False
            mLogHandle = 0
        End If
    End Sub

    ' The output sink the core and tests call. Debug.Print always; write to
    ' the log file when one is open. A log write failure is deliberately
    ' swallowed here -- output should never be able to abort the operation
    ' that produced it; the open-time check in LogOpen is where log problems
    ' surface.
    Public Sub Say(ByVal s As String)
        Debug.Print s
        If mLogOpen Then
            Dim b() As Byte, n As Long
            Utf8Encode s & vbCrLf, b, n
            If n > 0 Then
                Dim written As Long
                WriteFile mLogHandle, b(0), n, written, ByVal vbNullPtr
            End If
        End If
    End Sub

End Module
